# ==============================================================================
# SwipeCollab - AWS Free Tier Environment Variables Template
# ==============================================================================

# General Application Settings
DEBUG=False
SECRET_KEY=generate_a_secure_50_character_secret_key_here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-ec2-ip.compute-1.amazonaws.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://your-ec2-ip
SITE_URL=https://yourdomain.com

# AWS RDS Database Settings (PostgreSQL db.t3.micro / db.t4g.micro Free Tier)
# Alternatively, specify DATABASE_URL=postgres://dbuser:dbpass@your-rds-endpoint.rds.amazonaws.com:5432/swipecollab
DB_ENGINE=django.db.backends.postgresql
DB_NAME=swipecollab
DB_USER=swipeadmin
DB_PASSWORD=your_secure_rds_password_here
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432

# AWS S3 Storage Settings (Free Tier 5GB Media Uploads Bucket)
AWS_STORAGE_BUCKET_NAME=swipecollab-media-storage
AWS_ACCESS_KEY_ID=AKIAYOURAWSACCESSKEYID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_REGION_NAME=us-east-1

# Optional S3 Backup Bucket (for database & media automated backups)
AWS_BACKUP_BUCKET_NAME=swipecollab-database-backups

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=SwipeCollab <noreply@yourdomain.com>

# Optional Redis / Channels (Local EC2 Redis container or ElastiCache)
# REDIS_URL=redis://localhost:6379/0
